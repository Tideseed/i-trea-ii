# environments and caches
.venv/
__pycache__/
*.pyc
.pytest_cache/
.hypothesis/
.DS_Store
# instances (symlinks to public data; see vault/10-design/Datasets.md)
data/
# run outputs: raw traces and logs are regenerated by the jobs (resource records are committed)
traces/raw/
traces/sol/
logs/
# derived run tables: rebuilt from the traces by `itrea build-runs` (datasets/README.md); not committed
datasets/*.parquet
# LaTeX build products
paper/*.aux
paper/*.log
paper/*.out
paper/*.bbl
paper/*.blg
paper/*.fls
paper/*.fdb_latexmk
paper/*.synctex.gz
# Obsidian workspace state
vault/.obsidian/workspace*.json
# secrets and local agent settings: never committed
.env
*.env
*.key
*.pem
credentials*.json
.claude/settings.local.json
